{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "melka-game-server",
  "main": "worker.js",
  "compatibility_date": "2026-11-27",
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ]
}
